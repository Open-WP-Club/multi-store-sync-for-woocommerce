{
    "name": "wc-multi-store-sync/wc-multi-store-sync",
    "description": "WooCommerce Multi-Store Product Sync Plugin",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "brain/monkey": "^2.7",
        "mockery/mockery": "^1.6",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WC_Multi_Store_Sync\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "lint": "parallel-lint --exclude vendor ."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
