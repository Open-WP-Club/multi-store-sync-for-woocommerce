<?xml version="1.0"?>
<ruleset name="WC Multi Store Sync">
    <description>WordPress security conventions (nonces, sanitization, escaping, SQL prep) for this plugin.</description>

    <arg value="sp"/>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs.cache"/>
    <ini name="memory_limit" value="512M"/>

    <file>includes</file>
    <file>admin</file>
    <file>wc-multi-store-sync.php</file>

    <!-- WPCS 3.x dropped the standalone "WordPress-Security" ruleset; the
         equivalent sniffs now live directly under these two categories. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="multi-store-sync-for-woocommerce"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.Utils.I18nTextDomainFixer">
        <properties>
            <property name="old_text_domain" type="array">
                <element value="wc-multi-store-sync"/>
            </property>
            <property name="new_text_domain" value="multi-store-sync-for-woocommerce"/>
        </properties>
    </rule>
    <rule ref="WordPress.DB">
        <!-- This plugin's sync-log/queue tables are custom, non-cached-by-WP-core
             tables by design (short-lived operational data) — WPCS's object-cache
             sniffs assume core-style caching that doesn't apply here. This exclusion
             is the standard WPCS-recommended pattern for plugins with custom tables. -->
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    </rule>

    <config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
